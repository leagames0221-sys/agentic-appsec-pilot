{
  "name": "agentic-appsec-pilot",
  "version": "0.1.0",
  "description": "Local-first AI-agent harness for defensive AppSec: threat modeling + SAST/SCA + patch suggestion + SARIF 2.1.0 for TS/JS/Python codebases. Daybreak-style OSS, runs on Ollama by default, $0/month.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "tomohiro takada",
  "repository": {
    "type": "git",
    "url": "https://github.com/leagames0221-sys/agentic-appsec-pilot"
  },
  "bin": {
    "agentic-appsec": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src tests scripts",
    "bench": "tsx scripts/benchmark.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "packageManager": "pnpm@10.33.4"
}
